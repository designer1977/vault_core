{
  "name": "PageView",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Page slug e.g. /jwt-secret-generator"
    },
    "referrer": {
      "type": "string",
      "description": "Referrer domain (not full URL)"
    }
  },
  "required": [
    "slug"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}