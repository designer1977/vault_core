{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Event name (e.g. hero_copy_clicked, password_generated)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}